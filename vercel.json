{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/checkout-config", "destination": "/api/checkout_config" },
    { "source": "/api/razorpay/:action", "destination": "/api/payments?action=:action" },
    {
      "source": "/api/admin-session",
      "destination": "/api/auth"
    },
    {
      "source": "/api/x9k2/upload",
      "destination": "/api/upload"
    },
    {
      "source": "/api/x9k2/upload/:path*",
      "destination": "/api/upload?path=:path*"
    },
    {
      "source": "/api/x9k2/:resource",
      "destination": "/api/admin?resource=:resource"
    },
    {
      "source": "/api/x9k2/:resource/:path*",
      "destination": "/api/admin?resource=:resource&path=:path*"
    },
    {
      "source": "/api/products/:id",
      "destination": "/api/store?resource=products&id=:id"
    },
    {
      "source": "/api/products",
      "destination": "/api/store?resource=products"
    },
    {
      "source": "/api/search",
      "destination": "/api/store?resource=search"
    },
    {
      "source": "/api/site-settings",
      "destination": "/api/store?resource=site-settings"
    },
    {
      "source": "/api/offer",
      "destination": "/api/store?resource=offer"
    },
    {
      "source": "/api/admin-login",
      "destination": "/api/auth"
    },
    {
      "source": "/api/theme-css",
      "destination": "/api/theme_css"
    },
    {
      "source": "/api/ping",
      "destination": "/api/health"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/frames/v2/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "0"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(self \"https://api.razorpay.com\" \"https://checkout.razorpay.com\")"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://checkout.razorpay.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https://ik.imagekit.io https://placehold.co https://*.razorpay.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://upload.imagekit.io https://ik.imagekit.io https://api.razorpay.com https://checkout.razorpay.com; font-src 'self' https://fonts.gstatic.com; frame-src https://api.razorpay.com https://*.razorpay.com; object-src 'none'; base-uri 'self'; form-action 'self' https://api.razorpay.com; frame-ancestors 'none';"
        }
      ]
    }
  ],
  "functions": {
    "api/*.py": {
      "maxDuration": 60,
      "excludeFiles": "{assets/**,public/**,node_modules/**,tests/**,scripts/**,dist/**,**/__pycache__/**,**/*.pyc}"
    }
  }
}
