{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/x9k2/upload",
      "destination": "/api/upload"
    },
    {
      "source": "/api/x9k2/upload/:path*",
      "destination": "/api/upload?path=:path*"
    },
    {
      "source": "/api/x9k2/:resource",
      "destination": "/api/admin?resource=:resource"
    },
    {
      "source": "/api/x9k2/:resource/:path*",
      "destination": "/api/admin?resource=:resource&path=:path*"
    },
    {
      "source": "/api/products/:id",
      "destination": "/api/store?resource=products&id=:id"
    },
    {
      "source": "/api/products",
      "destination": "/api/store?resource=products"
    },
    {
      "source": "/api/search",
      "destination": "/api/store?resource=search"
    },
    {
      "source": "/api/site-settings",
      "destination": "/api/store?resource=site-settings"
    },
    {
      "source": "/api/offer",
      "destination": "/api/store?resource=offer"
    },
    {
      "source": "/api/admin-login",
      "destination": "/api/auth"
    },
    {
      "source": "/api/theme-css",
      "destination": "/api/theme_css"
    },
    {
      "source": "/api/ping",
      "destination": "/api/health"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/frames/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" },
        { "key": "Pragma",        "value": "no-cache" }
      ]
    },
    {
      "source": "/:path*",
      "headers": [
        { "key": "X-Content-Type-Options",   "value": "nosniff" },
        { "key": "X-Frame-Options",          "value": "DENY" },
        { "key": "X-XSS-Protection",         "value": "1; mode=block" },
        { "key": "Referrer-Policy",          "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",       "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "Strict-Transport-Security","value": "max-age=63072000; includeSubDomains; preload" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https://ik.imagekit.io https://placehold.co; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://upload.imagekit.io; font-src 'self' https://fonts.gstatic.com; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none';"
        }
      ]
    }
  ]
}
