{
  "mailer_subjects_confirmation": "Confirm your email for CALVAC",
  "mailer_templates_confirmation_content": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <meta name=\"color-scheme\" content=\"light dark\">\n  <meta name=\"supported-color-schemes\" content=\"light dark\">\n  <title>Confirm your email for CALVAC</title>\n  <style>\n    :root{color-scheme:light dark;supported-color-schemes:light dark}\n    body{margin:0!important;padding:0!important;width:100%!important;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%}\n    table{border-collapse:collapse;mso-table-lspace:0pt;mso-table-rspace:0pt}\n    a{color:inherit}a:focus-visible{outline:2px solid #62615e;outline-offset:4px}\n    @media only screen and (max-width:620px){.outer-pad{padding:20px 12px!important}.content-pad{padding-left:24px!important;padding-right:24px!important}.headline{font-size:30px!important;line-height:36px!important}.brand{font-size:26px!important}.section-pad{padding-top:30px!important;padding-bottom:30px!important}}\n    @media (prefers-color-scheme:dark){.email-bg{background-color:#111110!important}.email-card{background-color:#1c1c1a!important;border-color:#3d3d38!important}.ink{color:#f1efea!important}.muted{color:#b7b6b0!important}.rule{border-color:#3d3d38!important}.button-bg{background-color:#f1efea!important}.button-label{color:#151514!important}.url-box{background-color:#111110!important;border-color:#3d3d38!important}.focus-link:focus-visible{outline-color:#b7b6b0!important}}\n    [data-ogsc] .email-bg{background-color:#111110!important}[data-ogsc] .email-card{background-color:#1c1c1a!important;border-color:#3d3d38!important}[data-ogsc] .ink{color:#f1efea!important}[data-ogsc] .muted{color:#b7b6b0!important}[data-ogsc] .rule{border-color:#3d3d38!important}[data-ogsc] .button-bg{background-color:#f1efea!important}[data-ogsc] .button-label{color:#151514!important}[data-ogsc] .url-box{background-color:#111110!important;border-color:#3d3d38!important}\n  </style>\n  <!--[if mso]><style>body,table,td,a{font-family:Arial,Helvetica,sans-serif!important}</style><![endif]-->\n</head>\n<body class=\"email-bg\" style=\"margin:0;padding:0;background-color:#ebe9e5;font-family:Arial,Helvetica,sans-serif;color:#151514;\">\n  <div style=\"display:none;max-height:0;overflow:hidden;opacity:0;mso-hide:all;\">Verify your email address to finish creating your CALVAC account.</div>\n  <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" class=\"email-bg\" bgcolor=\"#ebe9e5\" style=\"width:100%;background-color:#ebe9e5;\">\n    <tr><td class=\"outer-pad\" align=\"center\" style=\"padding:40px 16px;\">\n      <!--[if mso]><table role=\"presentation\" width=\"600\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\"><tr><td><![endif]-->\n      <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" class=\"email-card\" bgcolor=\"#f8f7f4\" style=\"width:100%;max-width:600px;table-layout:fixed;border-collapse:separate;border-spacing:0;background-color:#f8f7f4;border:1px solid #cccac4;border-radius:20px;\">\n        <tr><td class=\"content-pad rule\" style=\"padding:28px 40px;border-bottom:1px solid #cccac4;\">\n          <a class=\"brand ink focus-link\" href=\"https://calvac.in\" aria-label=\"CALVAC website\" style=\"font-family:Arial,Helvetica,sans-serif;font-size:28px;line-height:34px;font-weight:700;letter-spacing:-1.5px;color:#151514;text-decoration:none;\">CALVAC</a>\n        </td></tr>\n        <tr><td class=\"content-pad section-pad\" style=\"padding:38px 40px 36px;\">\n          <p class=\"muted\" style=\"margin:0 0 16px;color:#62615e;font-size:11px;line-height:17px;font-weight:700;letter-spacing:1.7px;text-transform:uppercase;\">Confirm your email</p>\n          <h1 class=\"headline ink\" style=\"margin:0 0 20px;color:#151514;font-size:36px;line-height:42px;letter-spacing:-1.3px;font-weight:500;\">Welcome to CALVAC.</h1>\n          <p class=\"ink\" style=\"margin:0 0 28px;color:#151514;font-size:16px;line-height:26px;\">Welcome to CALVAC. Confirm your email address to finish setting up your account.</p>\n          <table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"margin:0 0 26px;\">\n            <tr><td class=\"button-bg\" bgcolor=\"#151514\" align=\"center\" style=\"background-color:#151514;border-radius:999px;mso-padding-alt:16px 28px;\">\n              <a class=\"button-label focus-link\" data-auth-action href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;padding:16px 28px;border-radius:999px;color:#ffffff;text-decoration:none;font-size:15px;line-height:20px;font-weight:700;\">Verify email&nbsp; &#8599;</a>\n            </td></tr>\n          </table>\n          <p class=\"muted\" style=\"margin:0 0 24px;color:#62615e;font-size:13px;line-height:21px;\">Open this link in the browser where you created your account. If you did not sign up for CALVAC, you can ignore this email.</p>\n          <p class=\"muted\" style=\"margin:0 0 10px;color:#62615e;font-size:12px;line-height:19px;\">Button not working? Copy this link into your browser:</p>\n          <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" class=\"url-box\" bgcolor=\"#ebe9e5\" style=\"width:100%;table-layout:fixed;border-collapse:separate;border-spacing:0;background-color:#ebe9e5;border:1px solid #cccac4;border-radius:10px;\">\n            <tr><td style=\"padding:12px 14px;word-break:break-all;overflow-wrap:anywhere;\">\n              <a class=\"muted focus-link\" data-auth-fallback href=\"{{ .ConfirmationURL }}\" style=\"color:#62615e;text-decoration:underline;font-family:Arial,Helvetica,sans-serif;font-size:11px;line-height:18px;word-break:break-all;overflow-wrap:anywhere;\">{{ .ConfirmationURL }}</a>\n            </td></tr>\n          </table>\n          <p class=\"muted\" style=\"margin:16px 0 0;color:#62615e;font-size:12px;line-height:19px;\">For your security, this link expires and can only be used once. If it no longer works, request a new email on calvac.in.</p>\n        </td></tr>\n        <tr><td class=\"content-pad rule\" style=\"padding:24px 40px;border-top:1px solid #cccac4;\">\n          <p class=\"muted\" style=\"margin:0 0 6px;color:#62615e;font-size:12px;line-height:19px;\">Need a hand? <a class=\"ink focus-link\" href=\"https://calvac.in/contact\" style=\"color:#151514;text-decoration:underline;\">Contact CALVAC</a></p>\n          <p class=\"muted\" style=\"margin:0;color:#62615e;font-size:11px;line-height:18px;\">CALVAC &nbsp;/&nbsp; Account access &nbsp;/&nbsp; <a class=\"muted focus-link\" href=\"https://calvac.in\" style=\"color:#62615e;text-decoration:none;\">calvac.in</a></p>\n        </td></tr>\n      </table>\n      <!--[if mso]></td></tr></table><![endif]-->\n    </td></tr>\n  </table>\n</body>\n</html>\n",
  "mailer_subjects_recovery": "Reset your CALVAC password",
  "mailer_templates_recovery_content": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <meta name=\"color-scheme\" content=\"light dark\">\n  <meta name=\"supported-color-schemes\" content=\"light dark\">\n  <title>Reset your CALVAC password</title>\n  <style>\n    :root{color-scheme:light dark;supported-color-schemes:light dark}\n    body{margin:0!important;padding:0!important;width:100%!important;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%}\n    table{border-collapse:collapse;mso-table-lspace:0pt;mso-table-rspace:0pt}\n    a{color:inherit}a:focus-visible{outline:2px solid #62615e;outline-offset:4px}\n    @media only screen and (max-width:620px){.outer-pad{padding:20px 12px!important}.content-pad{padding-left:24px!important;padding-right:24px!important}.headline{font-size:30px!important;line-height:36px!important}.brand{font-size:26px!important}.section-pad{padding-top:30px!important;padding-bottom:30px!important}}\n    @media (prefers-color-scheme:dark){.email-bg{background-color:#111110!important}.email-card{background-color:#1c1c1a!important;border-color:#3d3d38!important}.ink{color:#f1efea!important}.muted{color:#b7b6b0!important}.rule{border-color:#3d3d38!important}.button-bg{background-color:#f1efea!important}.button-label{color:#151514!important}.url-box{background-color:#111110!important;border-color:#3d3d38!important}.focus-link:focus-visible{outline-color:#b7b6b0!important}}\n    [data-ogsc] .email-bg{background-color:#111110!important}[data-ogsc] .email-card{background-color:#1c1c1a!important;border-color:#3d3d38!important}[data-ogsc] .ink{color:#f1efea!important}[data-ogsc] .muted{color:#b7b6b0!important}[data-ogsc] .rule{border-color:#3d3d38!important}[data-ogsc] .button-bg{background-color:#f1efea!important}[data-ogsc] .button-label{color:#151514!important}[data-ogsc] .url-box{background-color:#111110!important;border-color:#3d3d38!important}\n  </style>\n  <!--[if mso]><style>body,table,td,a{font-family:Arial,Helvetica,sans-serif!important}</style><![endif]-->\n</head>\n<body class=\"email-bg\" style=\"margin:0;padding:0;background-color:#ebe9e5;font-family:Arial,Helvetica,sans-serif;color:#151514;\">\n  <div style=\"display:none;max-height:0;overflow:hidden;opacity:0;mso-hide:all;\">Choose a new password for your CALVAC account.</div>\n  <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" class=\"email-bg\" bgcolor=\"#ebe9e5\" style=\"width:100%;background-color:#ebe9e5;\">\n    <tr><td class=\"outer-pad\" align=\"center\" style=\"padding:40px 16px;\">\n      <!--[if mso]><table role=\"presentation\" width=\"600\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\"><tr><td><![endif]-->\n      <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" class=\"email-card\" bgcolor=\"#f8f7f4\" style=\"width:100%;max-width:600px;table-layout:fixed;border-collapse:separate;border-spacing:0;background-color:#f8f7f4;border:1px solid #cccac4;border-radius:20px;\">\n        <tr><td class=\"content-pad rule\" style=\"padding:28px 40px;border-bottom:1px solid #cccac4;\">\n          <a class=\"brand ink focus-link\" href=\"https://calvac.in\" aria-label=\"CALVAC website\" style=\"font-family:Arial,Helvetica,sans-serif;font-size:28px;line-height:34px;font-weight:700;letter-spacing:-1.5px;color:#151514;text-decoration:none;\">CALVAC</a>\n        </td></tr>\n        <tr><td class=\"content-pad section-pad\" style=\"padding:38px 40px 36px;\">\n          <p class=\"muted\" style=\"margin:0 0 16px;color:#62615e;font-size:11px;line-height:17px;font-weight:700;letter-spacing:1.7px;text-transform:uppercase;\">Reset your password</p>\n          <h1 class=\"headline ink\" style=\"margin:0 0 20px;color:#151514;font-size:36px;line-height:42px;letter-spacing:-1.3px;font-weight:500;\">Reset your password.</h1>\n          <p class=\"ink\" style=\"margin:0 0 28px;color:#151514;font-size:16px;line-height:26px;\">We received a request to reset the password for your CALVAC account. Use the button below to choose a new one.</p>\n          <table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"margin:0 0 26px;\">\n            <tr><td class=\"button-bg\" bgcolor=\"#151514\" align=\"center\" style=\"background-color:#151514;border-radius:999px;mso-padding-alt:16px 28px;\">\n              <a class=\"button-label focus-link\" data-auth-action href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;padding:16px 28px;border-radius:999px;color:#ffffff;text-decoration:none;font-size:15px;line-height:20px;font-weight:700;\">Reset password&nbsp; &#8599;</a>\n            </td></tr>\n          </table>\n          <p class=\"muted\" style=\"margin:0 0 24px;color:#62615e;font-size:13px;line-height:21px;\">Open this link in the browser where you requested the reset. If you did not request this, ignore this email. Your password will stay the same.</p>\n          <p class=\"muted\" style=\"margin:0 0 10px;color:#62615e;font-size:12px;line-height:19px;\">Button not working? Copy this link into your browser:</p>\n          <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" class=\"url-box\" bgcolor=\"#ebe9e5\" style=\"width:100%;table-layout:fixed;border-collapse:separate;border-spacing:0;background-color:#ebe9e5;border:1px solid #cccac4;border-radius:10px;\">\n            <tr><td style=\"padding:12px 14px;word-break:break-all;overflow-wrap:anywhere;\">\n              <a class=\"muted focus-link\" data-auth-fallback href=\"{{ .ConfirmationURL }}\" style=\"color:#62615e;text-decoration:underline;font-family:Arial,Helvetica,sans-serif;font-size:11px;line-height:18px;word-break:break-all;overflow-wrap:anywhere;\">{{ .ConfirmationURL }}</a>\n            </td></tr>\n          </table>\n          <p class=\"muted\" style=\"margin:16px 0 0;color:#62615e;font-size:12px;line-height:19px;\">For your security, this link expires and can only be used once. If it no longer works, request a new email on calvac.in.</p>\n        </td></tr>\n        <tr><td class=\"content-pad rule\" style=\"padding:24px 40px;border-top:1px solid #cccac4;\">\n          <p class=\"muted\" style=\"margin:0 0 6px;color:#62615e;font-size:12px;line-height:19px;\">Need a hand? <a class=\"ink focus-link\" href=\"https://calvac.in/contact\" style=\"color:#151514;text-decoration:underline;\">Contact CALVAC</a></p>\n          <p class=\"muted\" style=\"margin:0;color:#62615e;font-size:11px;line-height:18px;\">CALVAC &nbsp;/&nbsp; Account access &nbsp;/&nbsp; <a class=\"muted focus-link\" href=\"https://calvac.in\" style=\"color:#62615e;text-decoration:none;\">calvac.in</a></p>\n        </td></tr>\n      </table>\n      <!--[if mso]></td></tr></table><![endif]-->\n    </td></tr>\n  </table>\n</body>\n</html>\n"
}
