UPSTASH_REDIS_REST_TOKEN=
IK_PRIVATE_KEY=
IK_URL_ENDPOINT=
# Server only. Start with Razorpay test-mode credentials and a separate webhook secret.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
